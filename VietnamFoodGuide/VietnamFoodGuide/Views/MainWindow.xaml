<Window x:Class="VietnamFoodGuide.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VietnamFoodGuide.Converters"
        Title="Vietnam Food Guide"
        Height="780" Width="400"
        MinHeight="600" MinWidth="360"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Images/banner.png"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Image Converter -->
        <converters:StringToImageSourceConverter x:Key="ImageConverter"/>
        
        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="BtnBorder" Background="White" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5" CornerRadius="20" Padding="14,7" Margin="4,0" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.06" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="GroupName" Value="Categories"/>
        </Style>

        <!-- Bottom Nav Button Style -->
        <Style x:Key="BottomNavStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10E63946"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Status bar area -->
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search -->
            <RowDefinition Height="Auto"/>
            <!-- Categories -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- QR Banner (above bottom nav) -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom Nav -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== TOP STATUS BAR ===== -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Height="28">
            <Grid Margin="16,0">
                <TextBlock Text="Vietnam Food Guide" Foreground="White" FontSize="11"
                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0.9"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Language Selector -->
                    <ComboBox x:Name="CmbLanguage" Width="110" Height="20" 
                              FontSize="10" Margin="0,0,10,0"
                              SelectionChanged="LanguageChanged"
                              Background="White" Foreground="#333333"
                              BorderThickness="0">
                        <ComboBoxItem Content="🇻🇳 Tiếng Việt" Tag="vi"/>
                        <ComboBoxItem Content="🇺🇸 English" Tag="en"/>
                        <ComboBoxItem Content="🇨🇳 中文" Tag="zh"/>
                    </ComboBox>

                    <!-- Dark Mode Toggle -->
                    <Border x:Name="DarkModeToggle" Width="40" Height="20" CornerRadius="10"
                            Background="#22C55E" Cursor="Hand" Margin="0,0,10,0"
                            MouseLeftButtonUp="DarkModeToggle_Click" ToolTip="Chế độ tối">
                        <Grid>
                            <!-- Track -->
                            <Border x:Name="ToggleTrack" CornerRadius="10"
                                    Background="#22C55E"/>
                            <!-- Thumb -->
                            <Ellipse x:Name="ToggleThumb" Width="16" Height="16"
                                     Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"
                                     VerticalAlignment="Center"/>
                            <!-- Icon -->
                            <TextBlock x:Name="TxtDarkModeIcon" Text="☀️" FontSize="9"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,3,0" Foreground="White" Opacity="0.9"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TxtUserStatus" Text="👤 Khách" Foreground="White" FontSize="11" Opacity="0.9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== HEADER / BANNER ===== -->
        <Border Grid.Row="1" Height="160" ClipToBounds="True">
            <Grid>
                <Image Source="/Assets/Images/banner.png" Stretch="UniformToFill"/>
                <Border Background="#75000000"/>
                <Grid Margin="16,0">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="🍜 Vietnam Food Guide" Foreground="White" FontSize="22"
                                   FontWeight="ExtraBold">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.7" ShadowDepth="2"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtAppSubtitle" Text="Khám phá ẩm thực Việt Nam" Foreground="White"
                                   FontSize="13" Opacity="0.9" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== SEARCH BAR (floats over banner bottom) ===== -->
        <Border Grid.Row="2" Margin="16,-24,16,0" x:Name="SearchBarBorder"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Height="52"
                Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.18" ShadowDepth="6" Direction="270"/>
            </Border.Effect>
            <Grid Margin="16,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="Tìm món ăn, quán ăn..." Foreground="#AAAAAA" FontSize="14" FontStyle="Italic"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="14"
                         VerticalContentAlignment="Center" TextChanged="SearchFood" Padding="40,0,0,0"
                         Panel.ZIndex="1" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- ===== CATEGORY FILTER ===== -->
        <Border Grid.Row="3" Margin="0,28,0,0" Background="{DynamicResource BackgroundBrush}" Padding="0,10,0,8">
            <StackPanel>
                <TextBlock x:Name="TxtCategoriesLabel" Text="DANH MỤC" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,8"
                           Opacity="0.7"/>
                <ScrollViewer x:Name="CategoryScroll" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="12,0,12,0" PreviewMouseWheel="CategoryScroll_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton x:Name="RbAllCategories" Content="Tất cả" Tag="Tất cả" IsChecked="True" Style="{StaticResource CategoryButtonStyle}"
                                     FontSize="13" Click="FilterCategory"/>
                        <RadioButton x:Name="RbHaiSan" Content="🦐 Hải sản" Tag="Hải sản" Style="{StaticResource CategoryButtonStyle}"
                                     FontSize="13" Click="FilterCategory"/>
                        <RadioButton x:Name="RbOc" Content="🐚 Ốc" Tag="Ốc" Style="{StaticResource CategoryButtonStyle}"
                                     FontSize="13" Click="FilterCategory"/>
                        <RadioButton x:Name="RbBun" Content="🍜 Bún" Tag="Bún" Style="{StaticResource CategoryButtonStyle}"
                                     FontSize="13" Click="FilterCategory"/>
                        <RadioButton x:Name="RbNuong" Content="🍢 Nướng" Tag="Nướng" Style="{StaticResource CategoryButtonStyle}"
                                     FontSize="13" Click="FilterCategory"/>
                        <RadioButton x:Name="RbLauNuong" Content="🍲 Lẩu &amp; Nướng" Tag="Lẩu &amp; Nướng" Style="{StaticResource CategoryButtonStyle}"
                                     FontSize="13" Click="FilterCategory"/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ===== FOOD LIST (scrollable content area) ===== -->
        <ScrollViewer Grid.Row="4" Padding="12,8,12,8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
            <StackPanel>
                <!-- Empty State -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
                    <TextBlock Text="😞" FontSize="56" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtNoResults" Text="Không tìm thấy quán ăn" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="TxtTryDifferentSearch" Text="Thử tìm kiếm với từ khóa khác" FontSize="13"
                               Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Food Grid - single column on mobile -->
                <ItemsControl x:Name="FoodList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Mobile-style horizontal card -->
                            <Border Margin="4,6" Background="{DynamicResource SurfaceBrush}" CornerRadius="16"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="3"/>
                                </Border.Effect>
                                <Grid Height="110">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Image -->
                                    <Border Grid.Column="0" CornerRadius="16,0,0,16" ClipToBounds="True"
                                            Background="#E8E8E8">
                                        <Image Source="{Binding Image, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Content -->
                                    <Grid Grid.Column="1" Margin="14,10,12,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="15"
                                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="📍" FontSize="11" VerticalAlignment="Center"
                                                       Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding City}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Text="{Binding Rating, StringFormat=⭐ {0:F1}}"
                                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                                   FontSize="13" VerticalAlignment="Center" Margin="0,4,0,0"/>

                                        <Button Grid.Row="3" Tag="{Binding}" Content="{Binding ViewDetailsText}"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Click="OpenDetail" Height="32"
                                                FontSize="12" Margin="0,2,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bottom spacer for nav bar -->
                <Border Height="16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== QR SCAN NOTIFICATION BANNER (Above Bottom Nav) ===== -->
        <Border x:Name="QRNotificationBanner" Grid.Row="5" 
                Background="#FFF9E6" BorderBrush="#F59E0B" BorderThickness="0,2,0,0"
                Padding="10,8" Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.15" ShadowDepth="-3" Direction="90"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <Border Grid.Column="0" Background="#F59E0B" Width="32" Height="32" 
                        CornerRadius="16" VerticalAlignment="Center">
                    <TextBlock Text="📱" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <!-- Message -->
                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtQRTitle" Text="📱 Quét mã QR để trải nghiệm đầy đủ" 
                               FontSize="11" FontWeight="Bold" Foreground="#78350F"/>
                    <TextBlock x:Name="TxtQRMessage" Text="Mở khóa tất cả tính năng!" 
                               FontSize="9" Foreground="#92400E" Margin="0,1,0,0"/>
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnScanQR" Content="Quét" 
                            Background="#F59E0B" Foreground="White" 
                            BorderThickness="0" Padding="10,5" 
                            FontSize="10" FontWeight="Bold"
                            Cursor="Hand" Click="ScanQR_Click" Margin="0,0,3,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#D97706"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnDismissQR" Content="✕" 
                            Background="Transparent" Foreground="#92400E" 
                            BorderThickness="0" Padding="5" 
                            FontSize="13" Cursor="Hand" 
                            Click="DismissQR_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FEF3C7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BOTTOM NAVIGATION BAR ===== -->
        <Border Grid.Row="6" x:Name="BottomNavBorder"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.12" ShadowDepth="-4" Direction="90"/>
            </Border.Effect>
            <Grid Height="64" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Home (active) -->
                <Button Grid.Column="0" Style="{StaticResource BottomNavStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏠" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtNavHome" Text="Trang chủ" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- QR Scanner -->
                <Button Grid.Column="1" Style="{StaticResource BottomNavStyle}"
                        Click="OpenQRScanner">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📱" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtNavQRScanner" Text="Quét QR" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Favorites -->
                <Button Grid.Column="2" Style="{StaticResource BottomNavStyle}"
                        Click="OpenFavorites">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⭐" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtNavFavorites" Text="Yêu thích" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Profile -->
                <Button Grid.Column="3" Style="{StaticResource BottomNavStyle}"
                        Click="OpenProfile">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtNavAccount" Text="Tài khoản" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
