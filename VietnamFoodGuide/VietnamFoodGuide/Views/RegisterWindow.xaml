<Window x:Class="VietnamFoodGuide.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vietnam Food Guide - Đăng Ký"
        Height="750" Width="400"
        MinHeight="600" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="CanResize"
        Icon="/Assets/Images/banner.png">

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}">
            <TextBlock Text="Tạo tài khoản mới" Foreground="White" FontSize="11"
                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
        </Border>

        <!-- Header -->
        <Border Grid.Row="1" Height="140" ClipToBounds="True">
            <Grid>
                <Image Source="/Assets/Images/banner.png" Stretch="UniformToFill" Opacity="0.8"/>
                <Border Background="#80000000"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🍲 Vietnam Food Guide" Foreground="White" FontSize="20"
                               FontWeight="ExtraBold" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.7" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Đăng Ký Tài Khoản" Foreground="White" FontSize="14"
                               HorizontalAlignment="Center" Opacity="0.9" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,10">

                <!-- Message -->
                <Border x:Name="MessageBorder" CornerRadius="10" Padding="12,10"
                        Margin="0,0,0,14" Visibility="Collapsed" Background="#FFF0F0">
                    <TextBlock x:Name="MessageTextBlock" Foreground="#DC3545" FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="Tài khoản *" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        CornerRadius="12" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="UsernameTextBox" Height="48" Padding="44,0,12,0"
                                 FontSize="15" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Email -->
                <TextBlock Text="Email *" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        CornerRadius="12" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="✉️" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="EmailTextBox" Height="48" Padding="44,0,12,0"
                                 FontSize="15" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Password -->
                <TextBlock Text="Mật khẩu *" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        CornerRadius="12" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <PasswordBox x:Name="PasswordBox" Height="48" Padding="44,0,44,0"
                                     FontSize="15" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        <TextBox x:Name="PasswordTextBox" Height="48" Padding="44,0,44,0"
                                 FontSize="15" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="ShowPasswordButton" Content="👁" HorizontalAlignment="Right"
                                Width="44" Background="Transparent" BorderThickness="0"
                                FontSize="16" Cursor="Hand" Click="ShowPasswordButton_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Confirm Password -->
                <TextBlock Text="Xác nhận mật khẩu *" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        CornerRadius="12" Margin="0,0,0,20">
                    <Grid>
                        <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Height="48" Padding="44,0,44,0"
                                     FontSize="15" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        <TextBox x:Name="ConfirmPasswordTextBox" Height="48" Padding="44,0,44,0"
                                 FontSize="15" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="ShowConfirmPasswordButton" Content="👁" HorizontalAlignment="Right"
                                Width="44" Background="Transparent" BorderThickness="0"
                                FontSize="16" Cursor="Hand" Click="ShowConfirmPasswordButton_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Register Button -->
                <Button x:Name="RegisterButton" Content="Đăng Ký" Height="52"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"
                        FontSize="16" FontWeight="Bold" Click="RegisterButton_Click"
                        Cursor="Hand" Margin="0,0,0,14"
                        Style="{StaticResource GlobalButtonStyle}"/>

                <!-- Back to Login -->
                <TextBlock TextAlignment="Center" Margin="0,0,0,20" FontSize="14">
                    <Run Text="Đã có tài khoản? " Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Hyperlink Click="BackToLoginLink_Click" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold">
                        <Run Text="Đăng nhập"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="White"/>
    </Grid>
</Window>
