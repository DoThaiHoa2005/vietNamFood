<Window x:Class="VietnamFoodGuide.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vietnam Food Guide - Đăng Nhập"
        Height="700" Width="400"
        MinHeight="600" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="CanResize"
        Icon="/Assets/Images/banner.png">

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <!-- Top status bar -->
            <RowDefinition Height="28"/>
            <!-- Header / branding -->
            <RowDefinition Height="Auto"/>
            <!-- Form area -->
            <RowDefinition Height="*"/>
            <!-- Bottom safe area -->
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}">
            <TextBlock Text="Vietnam Food Guide" Foreground="White" FontSize="11"
                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
        </Border>

        <!-- Header Branding -->
        <Border Grid.Row="1" Height="180" ClipToBounds="True">
            <Grid>
                <Image Source="/Assets/Images/banner.png" Stretch="UniformToFill" Opacity="0.85"/>
                <Border Background="#80000000"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🍲" FontSize="44" HorizontalAlignment="Center"/>
                    <TextBlock Text="Vietnam Food Guide" Foreground="White" FontSize="22"
                               FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.8" ShadowDepth="2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Đăng nhập để tiếp tục" Foreground="White" FontSize="13"
                               HorizontalAlignment="Center" Opacity="0.85" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Scroll Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <StackPanel Margin="24,20,24,10">

                <!-- Error Message -->
                <Border x:Name="ErrorBorder" Background="#FFF0F0" CornerRadius="10" Padding="12,10"
                        Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ " FontSize="14"/>
                        <TextBlock x:Name="ErrorMessage" Foreground="#DC3545" FontSize="13"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Username -->
                <TextBlock Text="Tài khoản" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        CornerRadius="12" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False" Panel.ZIndex="1"/>
                        <TextBox x:Name="UsernameTextBox" Height="48" Padding="44,0,12,0"
                                 FontSize="15" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Password -->
                <TextBlock Text="Mật khẩu" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        CornerRadius="12" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0"
                                   IsHitTestVisible="False" Panel.ZIndex="1"/>
                        <PasswordBox x:Name="PasswordBox" Height="48" Padding="44,0,44,0"
                                     FontSize="15" Background="Transparent" BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        <TextBox x:Name="PasswordTextBox" Height="48" Padding="44,0,44,0"
                                 FontSize="15" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="ShowPasswordButton" Content="👁" HorizontalAlignment="Right"
                                Width="44" Background="Transparent" BorderThickness="0"
                                FontSize="16" Cursor="Hand" Click="ShowPasswordButton_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Remember Me -->
                <CheckBox x:Name="RememberMeCheckBox" Content="Ghi nhớ tài khoản"
                          Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                          Margin="0,0,0,20"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton" Content="Đăng Nhập" Height="52"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"
                        FontSize="16" FontWeight="Bold" Click="LoginButton_Click"
                        Cursor="Hand" Margin="0,0,0,14"
                        Style="{StaticResource GlobalButtonStyle}"/>

                <!-- Register Link -->
                <TextBlock TextAlignment="Center" Margin="0,0,0,20" FontSize="14">
                    <Run Text="Chưa có tài khoản? " Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Hyperlink Click="RegisterLink_Click" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold">
                        <Run Text="Đăng ký ngay"/>
                    </Hyperlink>
                </TextBlock>

                <!-- Demo Hint -->
                <Border Background="#F0F7FF" CornerRadius="10" Padding="12,10">
                    <TextBlock Text="💡 Demo: admin / admin123 hoặc user123 / user123"
                               FontSize="12" Foreground="#457B9D" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom safe area -->
        <Border Grid.Row="3" Background="White"/>
    </Grid>
</Window>
