<Window x:Class="VietnamFoodGuide.Views.FoodDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VietnamFoodGuide.Converters"
        Title="Chi tiết món ăn"
        Height="780" Width="400"
        MinHeight="600" MinWidth="360"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="/Assets/Images/banner.png">

    <Window.Resources>
        <!-- Image Converter -->
        <converters:StringToImageSourceConverter x:Key="ImageConverter"/>
        
        <Style x:Key="BaseButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="RedButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="GreenButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style x:Key="BlueButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        </Style>

        <Style x:Key="LanguageRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="20" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Status bar -->
            <RowDefinition Height="28"/>
            <!-- Hero image -->
            <RowDefinition Height="220"/>
            <!-- Scrollable content -->
            <RowDefinition Height="*"/>
            <!-- Fixed action bar -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom safe area -->
            <RowDefinition Height="16"/>
        </Grid.RowDefinitions>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="16,0">
                <Button x:Name="BtnBack" Content="← Quay lại" Click="Back_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White" FontSize="12" FontWeight="SemiBold"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"/>
                <TextBlock x:Name="TxtTitle" Text="Chi tiết món ăn" Foreground="White" FontSize="12"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- ===== HERO IMAGE ===== -->
        <Border Grid.Row="1" ClipToBounds="True" Background="#E8E8E8">
            <Grid>
                <Image x:Name="FoodImage" Stretch="UniformToFill"/>
                <!-- Gradient overlay at bottom -->
                <Border VerticalAlignment="Bottom" Height="80">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#CC000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Rating badge on image -->
                <Border x:Name="RatingBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,16,12" Background="#CC000000" CornerRadius="20" Padding="10,5">
                    <TextBlock x:Name="FoodRating" Foreground="White" FontWeight="Bold" FontSize="14"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== SCROLLABLE CONTENT ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource BackgroundBrush}">
            <StackPanel Margin="16,16,16,8">

                <!-- Food Name -->
                <TextBlock x:Name="FoodName" FontSize="24" FontWeight="Black"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                           LineHeight="30" Margin="0,0,0,8"/>

                <!-- Location chip -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="12,6"
                        HorizontalAlignment="Left" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.08" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FoodCity" FontSize="13" Foreground="{StaticResource SecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Description Section -->
                <TextBlock x:Name="TxtDescriptionLabel" Text="MÔ TẢ" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"
                           Margin="0,0,0,8"/>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="14,12" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.07" ShadowDepth="3"/>
                    </Border.Effect>
                    <TextBlock x:Name="FoodDescription" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="22"/>
                </Border>

                <!-- Speech status bar -->
                <Border x:Name="SpeechStatusBar" Background="#E8F4FD" CornerRadius="10" Padding="12,10"
                        Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔊 " FontSize="16"/>
                        <TextBlock x:Name="StatusText" Text="Đang phát thuyết minh..." FontSize="13"
                                   Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== FIXED ACTION BAR ===== -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,12,16,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.10" ShadowDepth="-4" Direction="90"/>
            </Border.Effect>
            <StackPanel>
                <!-- Row 1: Map + Speak -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnMap" Content="📍 Bản đồ" Click="OpenMap"
                            Style="{StaticResource GreenButtonStyle}" Height="46" FontSize="14"/>
                    <Button Grid.Column="2" x:Name="BtnSpeak" Content="🔊 Nghe" Click="SpeakVI"
                            Style="{StaticResource BlueButtonStyle}" Height="46" FontSize="14"/>
                </Grid>
                <!-- Row 2: Favorites + Stop -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="FavoritesBtn" Content="⭐ Yêu thích"
                            Background="#FFB800" Foreground="White"
                            Style="{StaticResource BaseButtonStyle}" Height="46" FontSize="14"/>
                    <Button Grid.Column="2" x:Name="BtnStop" Content="⏹ Dừng"
                            Background="#E63946" Foreground="White"
                            Style="{StaticResource BaseButtonStyle}" Height="46" FontSize="14"
                            Click="StopSpeak" Visibility="Collapsed"/>
                    <!-- Placeholder when BtnStop is hidden -->
                    <Border Grid.Column="2" x:Name="StopPlaceholder" Visibility="Visible"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom safe area -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"/>
    </Grid>
</Window>