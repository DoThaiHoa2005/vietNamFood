<Window x:Class="VietnamFoodGuide.Views.FoodDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết món ăn"
        Width="500" SizeToContent="Height"
        MaxHeight="900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Images/banner.png">

    <Window.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="RedButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="GreenButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style x:Key="BlueButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        </Style>

        <Style x:Key="LanguageRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Opacity="0.05" ShadowDepth="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Back Button -->
        <Button Content="⬅ Quay lại" Click="Back_Click" Style="{StaticResource RedButtonStyle}"
                HorizontalAlignment="Left" Margin="0,0,0,12"/>

        <!-- Food Image -->
        <Border CornerRadius="15" Margin="0,0,0,15" Background="White" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.08" ShadowDepth="4"/>
            </Border.Effect>
            <Image x:Name="FoodImage" Height="180" MaxWidth="380" Stretch="Uniform"/>
        </Border>

        <!-- Food Name -->
        <TextBlock x:Name="FoodName" FontSize="28" FontWeight="Black"
                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <!-- Location & Rating -->
        <Grid Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="📍" FontSize="16" Margin="0,0,6,0"/>
                <TextBlock x:Name="FoodCity" FontSize="14" Foreground="{StaticResource SecondaryBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="FoodRating" FontSize="14" Foreground="{StaticResource AccentBrush}"
                       FontWeight="Bold" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Description -->
        <TextBlock Text="Mô tả" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,6"/>
        <Border Background="White" CornerRadius="12" Padding="12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <TextBlock x:Name="FoodDescription" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" LineHeight="20"/>
        </Border>

        <!-- Language Selection -->
        <TextBlock Text="Chọn ngôn ngữ thuyết minh" FontSize="13" FontWeight="Bold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <RadioButton x:Name="LangVN" Content="🇻🇳 Việt" GroupName="Lang" IsChecked="True"
                         Style="{StaticResource LanguageRadioStyle}"/>
            <RadioButton x:Name="LangEN" Content="🇺🇸 Anh" GroupName="Lang"
                         Style="{StaticResource LanguageRadioStyle}"/>
            <RadioButton x:Name="LangCN" Content="🇨🇳 Trung" GroupName="Lang"
                         Style="{StaticResource LanguageRadioStyle}"/>
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📍 Bản đồ vị trí" Click="OpenMap"
                    Style="{StaticResource GreenButtonStyle}"/>
            <Button Grid.Column="2" x:Name="BtnSpeak" Content="🔊 Nghe thuyết minh" Click="SpeakVI"
                    Style="{StaticResource BlueButtonStyle}"/>
        </Grid>

        <!-- Stop Speech Button -->
        <Button x:Name="BtnStop" Content="⏹ Dừng thuyết minh" Click="StopSpeak"
                Background="#E63946" Foreground="White"
                Style="{StaticResource BaseButtonStyle}"
                Visibility="Collapsed"/>

        <!-- Hidden action button for mobile-like layout -->
        <Button x:Name="FavoritesBtn" Content="⭐ Thêm yêu thích" Background="#FFB800"
                Foreground="White" Style="{StaticResource BaseButtonStyle}"/>
    </StackPanel>
</Window>