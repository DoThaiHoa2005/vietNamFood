<Window x:Class="VietnamFoodGuide.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vietnam Food Guide"
        Height="750" Width="1100"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Images/banner.png">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="BtnBorder" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="20" Padding="18,8" Margin="5,0" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="GroupName" Value="Categories"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}">

            <!-- Banner Section -->
            <Border Height="200" ClipToBounds="True">
                <Grid>
                    <Image Source="/Assets/Images/banner.png" Stretch="UniformToFill"/>
                    <Border Background="#70000000"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Vietnam Food Guide" Foreground="White" FontSize="56" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.8" ShadowDepth="4"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="🍜 Khám phá ẩm thực tinh túy Việt Nam 🍲" Foreground="White" FontSize="18"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0" Opacity="0.95"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search Section -->
            <Border Background="White" CornerRadius="25" Height="50" MaxWidth="700"
                    HorizontalAlignment="Center" Margin="0,-25,0,25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="8" Direction="270"/>
                </Border.Effect>
                <Grid Margin="22,0,22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="🔍" FontSize="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Tìm quán ăn..." Foreground="#B0B0B0" FontSize="16" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="16"
                             VerticalContentAlignment="Center" TextChanged="SearchFood" Padding="45,0,0,0"
                             Panel.ZIndex="1" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
            </Border>

            <!-- Category Filter -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Danh mục" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="40,0,0,10"/>
                <ScrollViewer x:Name="CategoryScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Margin="40,0,20,0" PreviewMouseWheel="CategoryScroll_PreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton Content="Tất cả" IsChecked="True" Style="{StaticResource CategoryButtonStyle}" Click="FilterCategory"/>
                        <RadioButton Content="🍜 Phở" Style="{StaticResource CategoryButtonStyle}" Click="FilterCategory"/>
                        <RadioButton Content="🍲 Bún" Style="{StaticResource CategoryButtonStyle}" Click="FilterCategory"/>
                        <RadioButton Content="🍚 Cơm" Style="{StaticResource CategoryButtonStyle}" Click="FilterCategory"/>
                        <RadioButton Content="🥖 Bánh Mì" Style="{StaticResource CategoryButtonStyle}" Click="FilterCategory"/>
                        <RadioButton Content="🥮 Bánh Khác" Style="{StaticResource CategoryButtonStyle}" Click="FilterCategory"/>
                        <RadioButton Content="☕ Thức uống" Style="{StaticResource CategoryButtonStyle}" Click="FilterCategory"/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>

        <!-- Food List -->
        <ScrollViewer Padding="20" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Empty State -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,100,0,0">
                    <TextBlock Text="😞" FontSize="60" HorizontalAlignment="Center"/>
                    <TextBlock Text="Không tìm thấy quán ăn" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- Food Grid -->
                <ItemsControl x:Name="FoodList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="290" Margin="15" Background="White" CornerRadius="18" Padding="0"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Opacity="0.08" ShadowDepth="4"/>
                                </Border.Effect>
                                <Grid x:Name="CardGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="180"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Image -->
                                    <Border Grid.Row="0" CornerRadius="18,18,0,0" ClipToBounds="True" Background="#E0E0E0">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Row="1" Margin="15,15,15,15">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                                   Margin="0,8,0,4" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" MaxHeight="50"/>
                                        <Grid Margin="0,6,0,12">
                                            <TextBlock Text="{Binding City}" Foreground="{StaticResource SecondaryBrush}"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Rating, StringFormat=⭐ \{0:F1\}}"
                                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Button Content="Xem chi tiết" Style="{StaticResource RoundedButtonStyle}"
                                                Click="OpenDetail" Margin="0,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>