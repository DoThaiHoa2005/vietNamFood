<Window x:Class="VietnamFoodGuide.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vietnam Food Guide - Đăng Ký" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="White"
        ResizeMode="NoResize"
        Icon="/Assets/Images/banner.png">
    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <!-- Title -->
            <TextBlock Text="🍲 Vietnam Food Guide"
                       FontSize="28"
                       Foreground="{StaticResource PrimaryBrush}"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Đăng Ký Tài Khoản"
                       FontSize="18"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Error/Success Message -->
            <TextBlock x:Name="MessageTextBlock"
                       Foreground="#DC3545"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"
                       Visibility="Collapsed"/>

            <!-- Username -->
            <TextBlock Text="Tài khoản *"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBox x:Name="UsernameTextBox"
                     Height="40"
                     Padding="12,10"
                     FontSize="14"
                     Background="#F8F9FA"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     Margin="0,0,0,15"/>

            <!-- Email -->
            <TextBlock Text="Email *"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBox x:Name="EmailTextBox"
                     Height="40"
                     Padding="12,10"
                     FontSize="14"
                     Background="#F8F9FA"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     Margin="0,0,0,15"/>

            <!-- Password -->
            <TextBlock Text="Mật khẩu *"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Padding="12,10"
                             FontSize="14"
                             Background="#F8F9FA"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             Grid.Column="0"/>

                <TextBox x:Name="PasswordTextBox"
                         Height="40"
                         Padding="12,10"
                         FontSize="14"
                         Background="#F8F9FA"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"
                         Grid.Column="0"
                         Visibility="Collapsed"/>

                <Button x:Name="ShowPasswordButton"
                        Grid.Column="1"
                        Content="👁"
                        Background="Transparent"
                        Foreground="#666"
                        BorderThickness="0"
                        FontSize="18"
                        Cursor="Hand"
                        Click="ShowPasswordButton_Click"/>
            </Grid>

            <!-- Confirm Password -->
            <TextBlock Text="Xác nhận mật khẩu *"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="40"
                             Padding="12,10"
                             FontSize="14"
                             Background="#F8F9FA"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             Grid.Column="0"/>

                <TextBox x:Name="ConfirmPasswordTextBox"
                         Height="40"
                         Padding="12,10"
                         FontSize="14"
                         Background="#F8F9FA"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"
                         Grid.Column="0"
                         Visibility="Collapsed"/>

                <Button x:Name="ShowConfirmPasswordButton"
                        Grid.Column="1"
                        Content="👁"
                        Background="Transparent"
                        Foreground="#666"
                        BorderThickness="0"
                        FontSize="18"
                        Cursor="Hand"
                        Click="ShowConfirmPasswordButton_Click"/>
            </Grid>

            <!-- Register Button -->
            <Button x:Name="RegisterButton"
                    Content="Đăng Ký"
                    Height="45"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Click="RegisterButton_Click"
                    Cursor="Hand"
                    Margin="0,0,0,10"
                    Style="{StaticResource GlobalButtonStyle}"/>

            <!-- Back to Login Link -->
            <TextBlock TextAlignment="Center" Margin="0,0,0,0">
                <Run Text="Đã có tài khoản? " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                <Hyperlink Click="BackToLoginLink_Click" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold">
                    <Run Text="Đăng nhập"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
