<Window x:Class="VietnamFoodGuide.Views.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Danh sách yêu thích"
        Height="780" Width="400"
        MinHeight="600" MinWidth="360"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="/Assets/Images/banner.png">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GlobalButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Status bar -->
            <RowDefinition Height="28"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Bottom safe area -->
            <RowDefinition Height="16"/>
        </Grid.RowDefinitions>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="16,0">
                <Button x:Name="BtnBack" Content="← Quay lại" Click="Back_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="White" FontSize="12" FontWeight="SemiBold"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"/>
                <TextBlock x:Name="TxtTitle" Text="Danh sách yêu thích" Foreground="White" FontSize="12"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="1" Background="White" Padding="16,14,16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.07" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12"
                            Width="44" Height="44" Margin="0,0,12,0">
                        <TextBlock Text="⭐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMyFavorites" Text="Yêu thích của tôi" FontSize="18" FontWeight="ExtraBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="CountTxt" Text="Đang tải..." FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh Button -->
                <Button x:Name="RefreshBtn" Content="🔄" Click="Refresh_Click"
                        Background="Transparent" BorderThickness="0"
                        FontSize="20" Cursor="Hand" HorizontalAlignment="Right"
                        VerticalAlignment="Center" ToolTip="Làm mới"/>
            </Grid>
        </Border>

        <!-- ===== SCROLLABLE CONTENT ===== -->
        <ScrollViewer Grid.Row="2" Padding="12,8,12,8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
            <StackPanel>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,80,0,0">
                    <TextBlock Text="💔" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtNoFavorites" Text="Chưa có món yêu thích" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="TxtAddSomeFavorites" Text="Thêm món ăn vào yêu thích để xem tại đây"
                               FontSize="13" Foreground="#AAAAAA" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="280" TextWrapping="Wrap"
                               Margin="0,8,0,24"/>
                    <Button x:Name="BtnBackToHome" Content="🏠 Về trang chủ" Click="Back_Click"
                            Style="{StaticResource RoundedButtonStyle}"
                            Height="46" Width="180" FontSize="14"/>
                </StackPanel>

                <!-- Favorites List - Mobile card style (same as MainWindow) -->
                <ItemsControl x:Name="FavoritesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,6" Background="White" CornerRadius="16" Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="3"/>
                                </Border.Effect>
                                <Grid Height="110">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" CornerRadius="16,0,0,16"
                                            ClipToBounds="True" Background="#E8E8E8">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Info -->
                                    <Grid Grid.Column="1" Margin="14,10,12,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="15"
                                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="24"/>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="📍" FontSize="11" VerticalAlignment="Center"
                                                       Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding City}" FontSize="12"
                                                       Foreground="{StaticResource SecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Rating, StringFormat=⭐ {0:F1}}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Bold" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,4,0,0"/>

                                        <Button Grid.Row="3" Tag="{Binding}" Content="{Binding ViewDetailsText}"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Click="ViewDetails" Height="32"
                                                FontSize="12" Margin="0,2,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bottom spacer -->
                <Border Height="16"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom safe area -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundBrush}"/>
    </Grid>
</Window>
