<Window x:Class="VietnamFoodGuide.Views.QRScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QR Scanner - Vietnam Food Guide"
        Height="780" Width="400"
        MinHeight="600" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResize"
        Icon="/Assets/Images/banner.png">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#1a73e8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1557b0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Status bar -->
            <RowDefinition Height="28"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Bottom actions -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom safe area -->
            <RowDefinition Height="16"/>
        </Grid.RowDefinitions>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}">
            <Grid Margin="16,0">
                <TextBlock Text="📱 Quét Mã QR" Foreground="White" FontSize="12"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- ===== SCROLLABLE CONTENT ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource BackgroundBrush}">
            <StackPanel Margin="16,16,16,8">
                
                <!-- Subtitle -->
                <TextBlock x:Name="TxtSubtitle" Text="Quét mã QR để truy cập" 
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- Camera Preview / WebView2 for QR Scanner -->
                <Border Background="White" CornerRadius="12" Padding="0" Height="280" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="3"/>
                    </Border.Effect>
                    <Grid>
                        <wv2:WebView2 x:Name="QRWebView" Visibility="Visible"/>
                        
                        <!-- Loading Overlay -->
                        <Border x:Name="LoadingOverlay" Background="#F0FFFFFF" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtLoading" Text="Đang khởi động camera..." 
                                           FontSize="14" Foreground="#5f6368"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Success Overlay -->
                        <Border x:Name="SuccessOverlay" Background="#E8F5E9" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✅" FontSize="64" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtSuccess" Text="Quét thành công!" 
                                           FontSize="18" FontWeight="Bold" Foreground="#2E7D32"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock x:Name="TxtSuccessDetail" Text="Đang chuyển đến trang chủ..." 
                                           FontSize="12" Foreground="#5f6368"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Instructions -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.07" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="TxtInstructionTitle" Text="📋 Hướng dẫn:" 
                                   FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtInstruction1" Text="1. Đưa mã QR vào khung hình" 
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   Margin="0,8,0,4"/>
                        <TextBlock x:Name="TxtInstruction2" Text="2. Hoặc chọn ảnh QR từ thư viện" 
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtInstruction3" Text="3. Hệ thống sẽ tự động quét và lưu" 
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Status Message -->
                <Border x:Name="StatusBorder" Background="#FFF3E0" CornerRadius="12" 
                        Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.07" ShadowDepth="3"/>
                    </Border.Effect>
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="12" 
                               Foreground="#E65100" TextWrapping="Wrap"/>
                </Border>

                <!-- Info Text -->
                <TextBlock x:Name="TxtInfo" 
                           Text="💡 Chỉ cần quét 1 lần duy nhất" 
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" 
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== FIXED ACTION BAR ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0"
                Padding="16,12,16,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.10" ShadowDepth="-4" Direction="90"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" x:Name="BtnSelectImage" Content="🖼 Chọn ảnh" 
                        Style="{StaticResource ModernButton}"
                        Background="#34a853" Click="SelectImage_Click" Height="46"/>
                <Button Grid.Column="2" x:Name="BtnSkip" Content="⏭️ Bỏ qua" 
                        Style="{StaticResource ModernButton}"
                        Background="#5f6368" Click="Skip_Click" Height="46"/>
            </Grid>
        </Border>

        <!-- Bottom safe area -->
        <Border Grid.Row="3" Background="White"/>
    </Grid>
</Window>
