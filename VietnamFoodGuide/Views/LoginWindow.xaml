<Window x:Class="VietnamFoodGuide.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vietnam Food Guide - Đăng Nhập" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="White"
        ResizeMode="NoResize"
        Icon="/Assets/Images/banner.png">
    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <!-- Title -->
            <TextBlock Text="🍲 Vietnam Food Guide"
                       FontSize="28"
                       Foreground="{StaticResource PrimaryBrush}"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Đăng Nhập"
                       FontSize="18"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Error Message -->
            <TextBlock x:Name="ErrorMessage"
                       Foreground="#DC3545"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"
                       Visibility="Collapsed"/>

            <!-- Username -->
            <TextBlock Text="Tài khoản"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBox x:Name="UsernameTextBox"
                     Height="40"
                     Padding="12,10"
                     FontSize="14"
                     Background="#F8F9FA"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     Margin="0,0,0,15"/>

            <!-- Password -->
            <TextBlock Text="Mật khẩu"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <!-- Password với Show/Hide Button -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>

                <!-- Hidden PasswordBox -->
                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Padding="12,10"
                             FontSize="14"
                             Background="#F8F9FA"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             Grid.Column="0"/>

                <!-- Visible TextBox (initially hidden) -->
                <TextBox x:Name="PasswordTextBox"
                         Height="40"
                         Padding="12,10"
                         FontSize="14"
                         Background="#F8F9FA"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"
                         Grid.Column="0"
                         Visibility="Collapsed"/>

                <!-- Show/Hide Button -->
                <Button x:Name="ShowPasswordButton"
                        Grid.Column="1"
                        Content="👁"
                        Background="Transparent"
                        Foreground="#666"
                        BorderThickness="0"
                        FontSize="18"
                        Cursor="Hand"
                        Click="ShowPasswordButton_Click"/>
            </Grid>

            <!-- Remember Me -->
            <CheckBox x:Name="RememberMeCheckBox"
                      Content="Ghi nhớ tài khoản"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,0,0,20"/>

            <!-- Login Button -->
            <Button x:Name="LoginButton"
                    Content="Đăng Nhập"
                    Height="45"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Click="LoginButton_Click"
                    Cursor="Hand"
                    Margin="0,0,0,10"
                    Style="{StaticResource GlobalButtonStyle}"/>

            <!-- Register Link -->
            <TextBlock TextAlignment="Center" Margin="0,0,0,20">
                <Run Text="Chưa có tài khoản? " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                <Hyperlink Click="RegisterLink_Click" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold">
                    <Run Text="Đăng ký ngay"/>
                </Hyperlink>
            </TextBlock>

            <!-- Info -->
            <TextBlock Text="Demo: admin/admin123 hoặc user123/user123"
                       FontSize="12"
                       Foreground="#999999"
                       TextAlignment="Center"
                       Margin="0,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
